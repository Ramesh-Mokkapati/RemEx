{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@vortexiot/rmxng-common": ["vendor/rmxng-common/index"],
      "@vortexiot/rmxng-common/client": ["vendor/rmxng-common/client"],
      "@vortexiot/rmxng-common/server": ["vendor/rmxng-common/server"],
      "@vortexiot/rmxng-common/shared": ["vendor/rmxng-common/shared"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
