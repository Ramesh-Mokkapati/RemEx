## JAQU Vehicle Entrants Lookup (Clean Air Zone)
# Required: base URL of the JAQU Vehicle Entrants API endpoint
# JAQU_VE_URL=https://api.cleanairzone.defra.gov.uk
# Required: API key sent as the x-api-key header
# JAQU_VE_API_KEY=
# Optional: override the default API path (default: /v1/vehicle-entrants)
# JAQU_VE_ENDPOINT=/v1/vehicle-entrants
# Optional: full OAuth2 token URL for client-credentials authentication
# JAQU_VE_OAUTH_URL=https://vccs-userpool.auth.eu-west-2.amazoncognito.com/oauth2/token
# Optional: OAuth2 client ID
# JAQU_VE_CLIENT_ID=
# Optional: OAuth2 client secret / shared secret
# JAQU_VE_CLIENT_SECRET=
