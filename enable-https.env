# ----------------------------------------------------------------------
# RMX-NG shared HTTPS environment variables (DEVELOPMENT)
#
# Source this file (or load it into your launcher / docker-compose) to
# enable HTTPS mode on every microservice. The keystore at
# ./dev-keystore.p12 is a self-signed certificate suitable for local
# testing only — replace with a CA-signed PKCS12 in production.
#
# Usage:
#   PowerShell:   . .\enable-https.ps1
#   bash:         set -a; . ./enable-https.env; set +a
# ----------------------------------------------------------------------
KEYSTORE_PATH=./dev-keystore.p12
TRUSTSTORE_PATH=./dev-keystore.p12
KEYSTORE_PASSWORD=changeit
KEYSTORE_TYPE=PKCS12

# Per-service key alias — all share the same dev cert.
RMXAMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXEMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXRMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXDMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXWMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXAEMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXMMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXNMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXSMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXALMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXDSMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXLMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXASMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXRSMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXVGS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXMEVIS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXDRMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXAVCMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXEMCMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXRTMS_KEYSTORE_KEY_ALIAS=rmx-dev
RMXWFMS_KEYSTORE_KEY_ALIAS=rmx-dev

# Master HTTPS toggle per service — set to "true" to enable HTTPS.
RMXAMS_ENABLE_HTTPS=true
RMXEMS_ENABLE_HTTPS=true
RMXRMS_ENABLE_HTTPS=true
RMXDMS_ENABLE_HTTPS=true
RMXWMS_ENABLE_HTTPS=true
RMXAEMS_ENABLE_HTTPS=true
RMXMMS_ENABLE_HTTPS=true
RMXNMS_ENABLE_HTTPS=true
RMXSMS_ENABLE_HTTPS=true
RMXALMS_ENABLE_HTTPS=true
RMXDSMS_ENABLE_HTTPS=true
RMXLMS_ENABLE_HTTPS=true
RMXASMS_ENABLE_HTTPS=true
RMXRSMS_ENABLE_HTTPS=true
RMXVGS_ENABLE_HTTPS=true
RMXMEVIS_ENABLE_HTTPS=true
RMXDRMS_ENABLE_HTTPS=true
RMXAVCMS_ENABLE_HTTPS=true
RMXEMCMS_ENABLE_HTTPS=true
RMXRTMS_ENABLE_HTTPS=true
RMXWFMS_ENABLE_HTTPS=true